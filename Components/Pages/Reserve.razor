@page "/reserve"
@rendermode InteractiveServer

<PageTitle>Reserve - Master Yoga</PageTitle>

<!-- ── INLINE RESERVATION MODAL ─────────────────────────────────────────── -->
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
        <div class="relative bg-[#131c54] border border-blue-900/80 rounded-xl max-w-lg w-full p-6 text-white shadow-2xl sm:p-8">

            <!-- Close -->
            <button @onclick="CloseModal"
                    class="absolute top-4 right-4 bg-transparent border-none text-[22px] font-light leading-none text-blue-200/85 cursor-pointer transition-colors hover:text-white p-0">
                ✕
            </button>

            @if (isSuccess)
            {
                <!-- Success State -->
                <div class="text-center py-8 flex flex-col items-center gap-4">
                    <div class="w-16 h-16 rounded-full bg-green-500/15 text-green-400 flex items-center justify-center text-3xl">✓</div>
                    <h3 class="font-display font-black text-2xl uppercase tracking-tight text-white m-0">May The Force Be With You</h3>
                    <p class="text-blue-100/80 text-sm leading-relaxed m-0">
                        Reservation confirmed for <strong class="text-white">@model.FullName</strong>.<br />
                        A confirmation holocron has been dispatched to <strong class="text-white">@model.Email</strong>.
                    </p>
                    <button @onclick="ResetModal"
                            class="mt-2 bg-[#808dfd] text-[#0c102b] font-bold text-xs uppercase tracking-wider px-6 py-2.5 rounded-md border-none cursor-pointer transition-colors hover:bg-[#939ffd]">
                        Close
                    </button>
                </div>
            }
            else
            {
                <!-- Form State -->
                <h3 class="font-display font-black text-2xl uppercase tracking-tight text-white m-0 mb-2">Reserve Your Jedi Spot</h3>
                <p class="text-blue-200/80 text-xs m-0 mb-6">Step onto the mat under the guidance of the Jedi High Council.</p>

                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="flex flex-col gap-4">
                        <!-- Full Name -->
                        <div>
                            <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Jedi Full Name</label>
                            <InputText @bind-Value="model.FullName"
                                       class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors"
                                       placeholder="e.g., Ahsoka Tano" />
                            <ValidationMessage For="@(() => model.FullName)" class="text-red-400 text-xs mt-1 block" />
                        </div>

                        <!-- Email + Phone -->
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Comlink Email</label>
                                <InputText @bind-Value="model.Email"
                                           class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors"
                                           placeholder="jedi@order.com" />
                                <ValidationMessage For="@(() => model.Email)" class="text-red-400 text-xs mt-1 block" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Phone / Holo-ID</label>
                                <InputText @bind-Value="model.Phone"
                                           class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors"
                                           placeholder="(203) 555-5555" />
                            </div>
                        </div>

                        <!-- Session -->
                        <div>
                            <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Desired Session</label>
                            <InputSelect @bind-Value="model.ClassTitle"
                                         class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors">
                                <option value="Master Yoda Frog Malasana & Hip Mobility">Master Yoda Frog Malasana (60 min)</option>
                                <option value="Cobra & Upward Dog Spine Realignment">Cobra & Upward Dog Spine (45 min)</option>
                                <option value="Soresu Defensive Vinyasa Flow">Soresu Defensive Vinyasa (75 min)</option>
                                <option value="Vaapad High-Intensity Power Stretch">Vaapad Power Stretch (60 min)</option>
                                <option value="Nautolan Aquatic Yin & Deep Restoration">Nautolan Aquatic Yin (90 min)</option>
                            </InputSelect>
                        </div>

                        <!-- Date + Force Rank -->
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Preferred Date</label>
                                <InputDate @bind-Value="model.PreferredDate"
                                           class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-[0.12em] text-blue-200/90 mb-1">Force Sensitivity</label>
                                <InputSelect @bind-Value="model.ForceRank"
                                             class="w-full bg-[#0d143f] border border-blue-800/80 rounded-md px-3.5 py-2 text-sm text-white outline-none focus:border-blue-400 transition-colors">
                                    <option value="Youngling">Youngling (Beginner)</option>
                                    <option value="Padawan">Padawan (Intermediate)</option>
                                    <option value="Jedi Knight">Jedi Knight (Advanced)</option>
                                    <option value="Jedi Master">Jedi Master (Elite)</option>
                                </InputSelect>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex justify-end items-center gap-3 pt-2">
                            <button type="button" @onclick="CloseModal"
                                    class="px-4 py-2 text-sm font-semibold text-blue-200/85 bg-transparent border-none cursor-pointer transition-colors hover:text-white">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="bg-[#808dfd] hover:bg-[#939ffd] text-[#0c102b] font-bold text-xs uppercase tracking-[0.12em] px-6 py-2 rounded-md border-none cursor-pointer transition-colors">
                                Confirm Spot
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

<div class="w-full min-h-screen bg-[#29326c] text-white font-sans overflow-x-hidden">

    <!-- SHARED NAVBAR -->
    <NavBar ActivePage="reserve" />


    <!-- SECTION 1: HERO TITLE BANNER -->
    <section class="w-full bg-[#4a5cce] px-5 py-3.5 border-t border-b border-[#38438a]/30 select-none md:px-10 md:py-5 lg:px-12 lg:py-[22px]">
        <h1 class="font-display font-black leading-none tracking-[-0.04em] uppercase m-0 flex flex-wrap items-center gap-[0.25em] text-[44px] md:text-[72px] lg:text-[96px] xl:text-[128px]">
            <span class="text-white">BOOK A</span>
            <span class="text-[#7887dc]">SESSION</span>
        </h1>
    </section>

    <!-- SECTION 2: THREE-COLUMN CARDS -->
    <section class="w-full flex flex-col border-b border-[#38438a] bg-[#29326c] md:flex-row">

        <!-- Card 1: STRENGTH -->
        <div class="flex flex-col justify-between px-6 py-8 border-b border-[#38438a] min-h-[380px] md:flex-1 md:border-b-0 md:border-r md:border-[#38438a] md:px-7 md:py-9 md:min-h-[480px] lg:px-9 lg:py-12 xl:px-11 xl:py-14">
            <div>
                <h2 class="font-display font-black leading-[1.1] tracking-tight uppercase text-white m-0 mb-6 text-[26px] lg:text-[30px]">
                    STRENGTH
                </h2>
                <div class="flex flex-col gap-4 mb-6">
                    <div class="text-[13px] font-medium text-white pb-2.5 border-b border-white/20">Weekdays at 6AM</div>
                    <div class="text-[13px] font-medium text-white pb-2.5 border-b border-white/20">Weekends and Holidays at 8AM</div>
                </div>
                <p class="text-[13px] text-blue-100/90 leading-[1.65] font-normal m-0 lg:text-[14px]">
                    Build a foundation of raw power with our comprehensive weightlifting and strength training programs.
                </p>
            </div>
            <button @onclick='() => OpenModal("Vaapad High-Intensity Power Stretch")'
                    class="w-full mt-8 font-black text-[11px] tracking-[0.12em] uppercase bg-[#808dfd] text-[#0c102b] py-3 px-5 rounded-md border-none cursor-pointer shadow-md transition-all hover:bg-[#939ffd] hover:shadow-[0_5px_12px_rgba(128,141,253,0.3)] active:scale-[0.98] text-center">
                RESERVE YOUR SPOT
            </button>
        </div>

        <!-- Card 2: CONDITIONING -->
        <div class="flex flex-col justify-between px-6 py-8 border-b border-[#38438a] min-h-[380px] md:flex-1 md:border-b-0 md:border-r md:border-[#38438a] md:px-7 md:py-9 md:min-h-[480px] lg:px-9 lg:py-12 xl:px-11 xl:py-14">
            <div>
                <h2 class="font-display font-black leading-[1.1] tracking-tight uppercase text-white m-0 mb-6 text-[26px] lg:text-[30px]">
                    CONDITIONING
                </h2>
                <div class="flex flex-col gap-4 mb-6">
                    <div class="text-[13px] font-medium text-white pb-2.5 border-b border-white/20">Weekdays at 8AM</div>
                    <div class="text-[13px] font-medium text-white pb-2.5 border-b border-white/20">Weekends and Holidays at 10AM</div>
                </div>
                <p class="text-[13px] text-blue-100/90 leading-[1.65] font-normal m-0 lg:text-[14px]">
                    Push your limits with high-intensity workouts that challenge your cardiovascular endurance and build functional fitness.
                </p>
            </div>
            <button @onclick='() => OpenModal("Soresu Defensive Vinyasa Flow")'
                    class="w-full mt-8 font-black text-[11px] tracking-[0.12em] uppercase bg-[#808dfd] text-[#0c102b] py-3 px-5 rounded-md border-none cursor-pointer shadow-md transition-all hover:bg-[#939ffd] hover:shadow-[0_5px_12px_rgba(128,141,253,0.3)] active:scale-[0.98] text-center">
                RESERVE YOUR SPOT
            </button>
        </div>

        <!-- Card 3: COMMUNITY CLASSES -->
        <div class="flex flex-col justify-between px-6 py-8 min-h-[380px] md:flex-1 md:px-7 md:py-9 md:min-h-[480px] lg:px-9 lg:py-12 xl:px-11 xl:py-14">
            <div>
                <h2 class="font-display font-black leading-[1.1] tracking-tight uppercase text-white m-0 mb-6 text-[26px] lg:text-[30px]">
                    COMMUNITY<br />CLASSES
                </h2>
                <div class="flex flex-col gap-4 mb-6">
                    <div class="text-[13px] font-medium text-white pb-2.5 border-b border-white/20">Every day on the hour</div>
                </div>
                <p class="text-[13px] text-blue-100/90 leading-[1.65] font-normal m-0 lg:text-[14px]">
                    Experience the power of collective effort with our custom Workout of the Day. Push your limits alongside like-minded individuals.
                </p>
            </div>
            <button @onclick='() => OpenModal("Master Yoda Frog Malasana & Hip Mobility")'
                    class="w-full mt-8 font-black text-[11px] tracking-[0.12em] uppercase bg-[#808dfd] text-[#0c102b] py-3 px-5 rounded-md border-none cursor-pointer shadow-md transition-all hover:bg-[#939ffd] hover:shadow-[0_5px_12px_rgba(128,141,253,0.3)] active:scale-[0.98] text-center">
                RESERVE YOUR SPOT
            </button>
        </div>
    </section>

    <!-- SECTION 3: YOGA PERSONAL TRAINING -->
    <section class="w-full bg-[#150073] px-6 py-[72px] text-center flex flex-col items-center justify-center border-b border-[#38438a] md:py-[88px] md:px-9 lg:py-[100px] lg:px-12">
        <h2 class="font-display font-black uppercase tracking-tight text-white m-0 mb-5 max-w-[800px] text-[28px] md:text-[38px] lg:text-[46px]">
            YOGA PERSONAL TRAINING
        </h2>
        <p class="text-[13px] text-blue-100/90 leading-[1.65] font-normal max-w-[640px] mx-auto mb-7 m-0 md:text-[14px]">
            Receive personalized guidance and tailored programs designed to unlock your individual primal potential. Our expert coaches will guide you every step of the way.
        </p>
        <button @onclick='() => OpenModal("Nautolan Aquatic Yin & Deep Restoration")'
                class="font-black text-[11px] tracking-[0.12em] uppercase bg-[#202758] text-[#bfdbfe] py-3 px-7 rounded-md border border-[#38438a]/40 cursor-pointer shadow-md transition-all hover:bg-[#2c367a] hover:text-white active:scale-[0.97]">
            RESERVE YOUR SPOT
        </button>
    </section>

    <!-- SECTION 4: FOOTER -->
    <footer class="w-full bg-[#29326c] px-6 py-12 md:px-10 md:py-[60px] lg:px-[60px] lg:py-[72px]">
        <div class="font-display font-black leading-none tracking-[-0.04em] uppercase text-[#161c3e] mb-10 select-none text-[40px] md:text-[64px] lg:text-[80px]">
            Master Yoga
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
            <div class="flex flex-col">
                <h4 class="font-display font-black text-[13px] tracking-[0.15em] uppercase text-white m-0 mb-3.5">CONTACT</h4>
                <p class="text-[12px] leading-[1.7] text-blue-200/85 m-0">
                    Email: <a href="mailto:yoga@jedicouncil.com" class="text-blue-200/85 no-underline transition-colors hover:text-white">yoga@jedicouncil.com</a>
                </p>
                <p class="text-[12px] leading-[1.7] text-blue-200/85 m-0">
                    Phone: <a href="tel:2035555555" class="text-blue-200/85 no-underline transition-colors hover:text-white">(203) 555-5555</a>
                </p>
            </div>

            <div class="flex flex-col">
                <h4 class="font-display font-black text-[13px] tracking-[0.15em] uppercase text-white m-0 mb-3.5">OPENING HOURS</h4>
                <div class="flex flex-col gap-1 max-w-[220px]">
                    <div class="flex justify-between text-[12px] leading-[1.6] text-blue-200/85 font-medium"><span>MON – FRI</span><span>5:00 – 23:00</span></div>
                    <div class="flex justify-between text-[12px] leading-[1.6] text-blue-200/85 font-medium"><span>SATURDAYS</span><span>8:00 – 16:00</span></div>
                    <div class="flex justify-between text-[12px] leading-[1.6] text-blue-200/85 font-medium"><span>SUNDAYS</span><span>8:00 – 13:00</span></div>
                    <div class="flex justify-between text-[12px] leading-[1.6] text-blue-200/85 font-medium"><span>HOLIDAYS</span><span>8:00 – 16:00</span></div>
                </div>
            </div>

            <div class="flex flex-col">
                <h4 class="font-display font-black text-[13px] tracking-[0.15em] uppercase text-white m-0 mb-3.5">SOCIAL</h4>
                <div class="flex flex-col gap-1.5">
                    <a href="https://instagram.com" target="_blank" class="text-[12px] leading-[1.7] text-blue-200/85 no-underline transition-colors hover:text-white">Instagram</a>
                    <a href="https://x.com" target="_blank" class="text-[12px] leading-[1.7] text-blue-200/85 no-underline transition-colors hover:text-white">X</a>
                    <a href="https://linkedin.com" target="_blank" class="text-[12px] leading-[1.7] text-blue-200/85 no-underline transition-colors hover:text-white">LinkedIn</a>
                    <a href="https://spotify.com" target="_blank" class="text-[12px] leading-[1.7] text-blue-200/85 no-underline transition-colors hover:text-white">Spotify</a>
                </div>
            </div>
        </div>
    </footer>

</div>

@code {
    private bool showModal = false;
    private bool isSuccess = false;
    private ReservationModel model = new();

    private void OpenModal(string classTitle)
    {
        model = new ReservationModel { ClassTitle = classTitle };
        isSuccess = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void HandleSubmit()
    {
        isSuccess = true;
    }

    private void ResetModal()
    {
        isSuccess = false;
        model = new();
        showModal = false;
    }
}
